# ===== 서버 =====
PORT=8080
NODE_ENV=production
APP_BASE_URL=https://app.example.co.kr     # 학생 QR이 가리킬 주소

# ===== 데이터베이스 (PostgreSQL) =====
DATABASE_URL=postgres://app_user:password@host:5432/winners_ai          # 웹 요청용 (학원별 분리 적용)
DATABASE_URL_BATCH=postgres://batch_user:password@host:5432/winners_ai  # 스케줄러용 (BYPASSRLS 권한)

# ===== 보안 키 (반드시 랜덤 값으로 교체) =====
JWT_SECRET=change-me-64-random-chars
# 학부모 전화번호 등 개인정보 암호화 키: 32바이트를 base64로 (openssl rand -base64 32)
PII_ENC_KEY=change-me-base64-32-bytes
# 전화번호 검색용 해시 키 (openssl rand -hex 32)
PII_HASH_KEY=change-me-hex-32-bytes

# ===== AI (Claude API) =====
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5-20251001          # 학생 질문용(빠르고 저렴)
AI_REPORT_MODEL=claude-sonnet-4-5           # 원장님 말투 상담글 생성용 (문장 품질 우선)
AI_FEEDBACK_MODEL=                            # (선택) 영작·풀이 첨삭용. 비우면 AI_REPORT_MODEL 사용 (손글씨 읽기 품질)

# ===== 결제 (토스페이먼츠 자동결제/빌링) =====
TOSS_SECRET_KEY=test_sk_...
TOSS_CLIENT_KEY=test_ck_...
# 요금은 DB plans 테이블이 기준입니다 (기본: 학생 30명 이하 월 49,000원)

# ===== 알림톡 (예: 솔라피) =====
SOLAPI_API_KEY=...
SOLAPI_API_SECRET=...
KAKAO_PF_ID=KA01PF...                       # 카카오 비즈니스 채널 연동 ID
KAKAO_TEMPLATE_WEEKLY=KA01TP...             # 승인받은 '주간 학습 리포트(자동 통계)' 템플릿 ID
KAKAO_TEMPLATE_COUNSEL=KA01TP...            # 승인받은 '주간 상담(원장 상담글)' 템플릿 ID
SENDER_PHONE=01020005369                    # 학원 대표번호 = 대체문자 발신번호 (솔라피에서 발신번호 등록·인증 필수)

# ===== 주간 상담글 =====
# inline: 상담글 본문을 알림톡에 그대로(기본) / link: 짧은 안내 + '상담글 전체 보기' 버튼
COUNSEL_MODE=inline
COUNSEL_MAX_CHARS=800

# ===== 학생 앱 =====
# 홈 화면 앱(PWA) 로그인 유지 시간 (기본 168시간 = 7일)
STUDENT_SESSION_HOURS=168

# 1이면 실제 발송 없이 로그만 출력
DRY_RUN=1
